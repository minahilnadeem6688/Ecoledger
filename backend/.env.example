# Copy to .env and adjust. Never commit the real .env.
# Everything has a working default for local development, so .env is optional locally.

# ─── Server ───────────────────────────────────────────────
PORT=5000
# Required in production: any long random string
JWT_SECRET=change-this-to-a-long-random-string
# Comma-separated sites allowed to call the API, e.g. https://ecoledger.vercel.app (empty = allow all)
CORS_ORIGIN=

# ─── Database ─────────────────────────────────────────────
# Local MongoDB, or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/ecoledger

# ─── First admin account (created on first start) ─────────
# In production the admin is only created when ADMIN_PASSWORD is set.
ADMIN_EMAIL=admin@ecoledger.dev
ADMIN_PASSWORD=admin123

# ─── Blockchain ───────────────────────────────────────────
# Local: leave these empty and run `npm run chain` + `npm run deploy`.
# Sepolia testnet: see docs/DEPLOYMENT.md.
RPC_URL=http://127.0.0.1:8545
# Private key of the wallet that deployed the contract (it signs every mint). Test wallet only.
OWNER_PRIVATE_KEY=
# Optional: otherwise read from deployments/<network>.json
CONTRACT_ADDRESS=

# Used by `npm run deploy:sepolia` (defaults to a free public RPC)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional, for `npx hardhat verify`
ETHERSCAN_API_KEY=
